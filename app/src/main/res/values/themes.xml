<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Day. The window background must match what Compose draws, or the launch frame
         flashes the wrong colour before the first composition. -->
    <style name="Theme.CourtPace" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Light background, so the system bar content must be dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
